# Paper management — anything inside paper/ is local-only and never published.
# This includes: paper.tex, results_snippet.tex, *.sty/*.bst, figures/,
# paper_tools/, analysis_outputs/, build artefacts, and any internal docs
# (HANDOFF.md, PLAN.md, etc.) dropped in.
paper/

# Python / build
__pycache__/
*.pyc
.python-version-local
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Run-time logs
logs/
missfont.log

# Pilot leftovers and backup files (results are otherwise tracked)
results/pilot*
results/apibank_frontier.jsonl
results/apibank_open_weights.jsonl
results/*.bak
results/*.before_402_filter*
results/smoke*
results/*.stdout.log

# OS / editors / secrets
.DS_Store
.idea/
.vscode/
.env
.env.local
